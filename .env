# Milvus Configuration
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_USER=root
MILVUS_PASSWORD=
MILVUS_DATABASE=

# Huawei Cloud MaaS Configuration
MAAS_API_URL=https://api.modelarts-maas.com/v2/chat/completions
MAAS_API_KEY=
MAAS_MODEL=qwen3-235b-a22b
JUDGE_MODEL=deepSeek-V3.2

# Embedding Model
EMBEDDING_PROVIDER=maas
EMBEDDING_MODEL=models/Qwen3-Embedding-0.6B
# Embedding device: "auto" (detect GPU/NPU), "cuda", "npu", "cpu"
EMBEDDING_DEVICE=auto
HF_ENDPOINT=https://hf-mirror.com

# MaaS Embedding (used when EMBEDDING_PROVIDER=maas)
MAAS_EMBEDDING_MODEL=bge-m3
MAAS_EMBEDDING_DIM=1024

# Neural Rerank (Huawei Cloud MaaS rerank API)
MAAS_RERANK_ENABLED=false
MAAS_RERANK_MODEL=bge-reranker-v2-m3

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Logging
LOG_LEVEL=INFO